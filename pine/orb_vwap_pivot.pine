//@version=6
// ORB + VWAP + Fibonacci Pivots — opening range breakout gated by a session
// VWAP bias and a prior-day fib pivot "is there room?" test.
//
// The five conditions are individually switchable so the Strategy Tester can
// answer the only question worth asking: does each filter actually earn its
// place? Turn them all off for a plain ORB baseline, then add one at a time.
//
//   1. VWAP side   price on the correct side of session VWAP
//   2. VWAP slope  VWAP moving in the trade's direction
//   3. Trigger     bar CLOSE beyond the opening range   (always required)
//   4. Pivot room  distance to next fib pivot >= minRR x stop
//   5. Pivot side  price on the correct side of daily pivot P
//
// Orders are market orders submitted on bar close, so TradingView fills them at
// the NEXT bar's open — no lookahead, matching src/backtest/ in this repo.

strategy("ORB + VWAP + Fib Pivots",
     shorttitle       = "ORB-VWAP-FIB",
     overlay          = true,
     pyramiding       = 0,
     initial_capital  = 5000,
     default_qty_type = strategy.fixed,
     default_qty_value= 1,
     slippage         = 1,
     commission_type  = strategy.commission.cash_per_order,
     commission_value = 0.62,
     calc_on_every_tick = false)

// ─── Session ──────────────────────────────────────────────────────────────
gS = "Session (minutes from midnight, exchange timezone)"
tz         = input.string("America/New_York", "Timezone",          group = gS)
orStartMin = input.int(570, "Opening range start  (09:30 = 570)",  group = gS)
orEndMin   = input.int(585, "Opening range end    (09:45 = 585)",  group = gS)
entryStart = input.int(585, "First entry allowed  (09:45 = 585)",  group = gS)
entryEnd   = input.int(660, "Last entry allowed   (11:00 = 660)",  group = gS)
flatByMin  = input.int(690, "Force flat           (11:30 = 690)",  group = gS)
sessEndMin = input.int(960, "Session end          (16:00 = 960)",  group = gS)

// ─── Filters ──────────────────────────────────────────────────────────────
gF = "Filters — switch off to isolate each one"
useVwapSide   = input.bool(true, "1. Price on correct side of VWAP", group = gF)
useVwapSlope  = input.bool(true, "2. VWAP sloping with the trade",   group = gF)
usePivotRoom  = input.bool(true, "4. Room to next fib pivot",        group = gF)
useAbovePivot = input.bool(true, "5. Price on correct side of P",    group = gF)
minScore      = input.int(4, "Minimum score to trade", minval = 1, maxval = 5, group = gF)
slopeLookback = input.int(3, "VWAP slope lookback (bars)", minval = 1, group = gF)
minRR         = input.float(2.0, "Minimum reward:risk", minval = 0.1, step = 0.1, group = gF)
firstBreakOnly= input.bool(true, "First break only (skip day if it fails)", group = gF,
     tooltip = "Classic ORB. Switch off and the strategy keeps hunting later " +
               "breaks, which makes every filter look weaker because a rejected " +
               "signal is usually replaced by a later qualifying one.")
allowShort    = input.bool(true, "Allow shorts", group = gF)
maxTradesDay  = input.int(1, "Max trades per day", minval = 1, group = gF)

// ─── Risk ─────────────────────────────────────────────────────────────────
gR = "Risk"
stopMode   = input.string("ATR", "Stop sizing", options = ["ATR", "Fixed", "VWAP"], group = gR)
atrLen     = input.int(14, "ATR length", minval = 1, group = gR)
atrMult    = input.float(1.2, "ATR multiplier", step = 0.1, group = gR)
fixedStop  = input.float(8.0, "Fixed stop (points)", step = 0.25, group = gR)
vwapBuffer = input.float(2.0, "VWAP stop buffer (points)", step = 0.25, group = gR)
minStopPts = input.float(3.0, "Min stop (points)", step = 0.25, group = gR)
maxStopPts = input.float(20.0, "Max stop (points)", step = 0.25, group = gR)
targetMode = input.string("Pivot", "Target", options = ["Pivot", "RR"], group = gR)
targetRR   = input.float(2.0, "Target R multiple (RR mode)", step = 0.1, group = gR)
pivotBuf   = input.float(2.0, "Exit this far in front of pivot", step = 0.25, group = gR)

showLevels = input.bool(true, "Draw levels", group = "Display")
showTable  = input.bool(true, "Show status table", group = "Display")

// ─── Time ─────────────────────────────────────────────────────────────────
etMin  = hour(time, tz) * 60 + minute(time, tz)
newDay = ta.change(time("D")) != 0

// ─── Prior-day fib pivots ─────────────────────────────────────────────────
// lookahead_on together with the [1] offset is the non-repainting idiom: it
// requests the PREVIOUS completed daily bar, which is already known intraday.
[pdH, pdL, pdC] = request.security(syminfo.tickerid, "D",
     [high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)

pRange = pdH - pdL
P  = (pdH + pdL + pdC) / 3
R1 = P + 0.382 * pRange
R2 = P + 0.618 * pRange
R3 = P + 1.000 * pRange
S1 = P - 0.382 * pRange
S2 = P - 0.618 * pRange
S3 = P - 1.000 * pRange

nextPivotUp(float px) =>
    float b = na
    b := P  > px and (na(b) or P  < b) ? P  : b
    b := R1 > px and (na(b) or R1 < b) ? R1 : b
    b := R2 > px and (na(b) or R2 < b) ? R2 : b
    b := R3 > px and (na(b) or R3 < b) ? R3 : b
    b

nextPivotDn(float px) =>
    float b = na
    b := P  < px and (na(b) or P  > b) ? P  : b
    b := S1 < px and (na(b) or S1 > b) ? S1 : b
    b := S2 < px and (na(b) or S2 > b) ? S2 : b
    b := S3 < px and (na(b) or S3 > b) ? S3 : b
    b

// ─── Session state ────────────────────────────────────────────────────────
var float orH       = na
var float orL       = na
var bool  breakSeen = false
var int   tradesDay = 0
var float cumPV     = 0.0
var float cumVol    = 0.0

if newDay
    orH       := na
    orL       := na
    breakSeen := false
    tradesDay := 0
    cumPV     := 0.0
    cumVol    := 0.0

// Session-anchored VWAP, accumulated explicitly so it matches the JS engine
// bar for bar rather than relying on ta.vwap's own session definition.
inSession = etMin >= orStartMin and etMin < sessEndMin
if inSession
    v = volume > 0 ? volume : 1
    cumPV  := cumPV  + hlc3 * v
    cumVol := cumVol + v
vwapVal = cumVol > 0 ? cumPV / cumVol : na

vwapSlope = na(vwapVal) or na(vwapVal[slopeLookback]) ? 0.0 : (vwapVal - vwapVal[slopeLookback]) / slopeLookback

inOR = etMin >= orStartMin and etMin < orEndMin
if inOR
    orH := na(orH) ? high : math.max(orH, high)
    orL := na(orL) ? low  : math.min(orL, low)

atrVal = ta.atr(atrLen)

// ─── Stop sizing ──────────────────────────────────────────────────────────
stopDistance(int dir, float px) =>
    float d = na
    if stopMode == "Fixed"
        d := fixedStop
    else if stopMode == "ATR"
        d := na(atrVal) ? na : atrVal * atrMult
    else
        vd = dir == 1 ? px - (vwapVal - vwapBuffer) : (vwapVal + vwapBuffer) - px
        od = dir == 1 ? px - orL : orH - px
        cand = math.min(vd > 0 ? vd : 1e10, od > 0 ? od : 1e10)
        d := cand >= 1e10 ? na : cand
    na(d) or d <= 0 ? na : math.min(math.max(d, minStopPts), maxStopPts)

// ─── Signal evaluation ────────────────────────────────────────────────────
var float pendStop     = na
var float pendTarget   = na
var bool  awaitingFill = false

canSignal = inSession and etMin >= entryStart and etMin <= entryEnd
     and not na(orH) and not na(orL) and not na(vwapVal) and not na(P)
     and strategy.position_size == 0
     and tradesDay < maxTradesDay
     and (not firstBreakOnly or not breakSeen)

longBreak  = canSignal and close > orH
shortBreak = canSignal and allowShort and close < orL
dir        = longBreak ? 1 : shortBreak ? -1 : 0

if dir != 0
    breakSeen := true

// Evaluate both sides on every bar rather than inside a ternary: Pine expects
// functions to be called consistently, and a conditional call can desync any
// series state they touch.
sdLong  = stopDistance(1, close)
sdShort = stopDistance(-1, close)
sd      = dir == 1 ? sdLong : dir == -1 ? sdShort : na

pivUp = nextPivotUp(close)
pivDn = nextPivotDn(close)
lv    = dir == 1 ? pivUp : dir == -1 ? pivDn : na
rawTgt = na(lv) ? na : math.abs(lv - close) - pivotBuf
pivotTgt = na(rawTgt) or rawTgt <= 0 ? na : rawTgt
rrTgt  = na(sd) ? na : sd * targetRR
tgt    = dir == 0 ? na : targetMode == "Pivot" ? pivotTgt : rrTgt

// Scorecard
cTrigger = dir != 0
cVwapSide  = dir == 1 ? close > vwapVal : close < vwapVal
cVwapSlope = dir == 1 ? vwapSlope > 0   : vwapSlope < 0
cPivotSide = dir == 1 ? close > P       : close < P
cPivotRoom = not na(sd) and not na(tgt) and tgt / sd >= minRR

score = (cTrigger ? 1 : 0)
     + (useVwapSide   and cVwapSide  ? 1 : 0)
     + (useVwapSlope  and cVwapSlope ? 1 : 0)
     + (useAbovePivot and cPivotSide ? 1 : 0)
     + (usePivotRoom  and cPivotRoom ? 1 : 0)

maxScore = 1 + (useVwapSide ? 1 : 0) + (useVwapSlope ? 1 : 0)
     + (useAbovePivot ? 1 : 0) + (usePivotRoom ? 1 : 0)

tradeable = dir != 0 and not na(sd) and not na(tgt)
takeTrade = tradeable and score >= math.min(minScore, maxScore)

// ─── Orders ───────────────────────────────────────────────────────────────
// Market order on bar close → filled at the next bar's open by TradingView.
if takeTrade
    pendStop     := sd
    pendTarget   := tgt
    awaitingFill := true
    tradesDay    := tradesDay + 1
    if dir == 1
        strategy.entry("L", strategy.long)
    else
        strategy.entry("S", strategy.short)

// Attach the bracket once the fill price is known.
if strategy.position_size != 0
    awaitingFill := false

if strategy.position_size != 0 and not na(pendStop) and not na(pendTarget)
    ep  = strategy.position_avg_price
    pdirection = strategy.position_size > 0 ? 1 : -1
    sl  = pdirection == 1 ? ep - pendStop   : ep + pendStop
    tp  = pdirection == 1 ? ep + pendTarget : ep - pendTarget
    if pdirection == 1
        strategy.exit("L-x", from_entry = "L", stop = sl, limit = tp)
    else
        strategy.exit("S-x", from_entry = "S", stop = sl, limit = tp)

// Forced flat — nothing is carried past the session window.
if strategy.position_size != 0 and etMin >= flatByMin
    strategy.close_all(comment = "time")
    pendStop   := na
    pendTarget := na

// Only clear once genuinely flat AND no fill is still pending — on the signal
// bar the order is submitted but position_size is still 0.
if strategy.position_size == 0 and not awaitingFill
    pendStop   := na
    pendTarget := na

// ─── Display ──────────────────────────────────────────────────────────────
plot(showLevels and not na(orH) ? orH : na, "OR High", color.new(color.orange, 0), 2, plot.style_linebr)
plot(showLevels and not na(orL) ? orL : na, "OR Low",  color.new(color.orange, 0), 2, plot.style_linebr)
plot(showLevels and inSession ? vwapVal : na, "VWAP",  color.new(color.blue, 0), 2, plot.style_linebr)

plot(showLevels ? P  : na, "P",  color.new(color.gray, 0),  1, plot.style_linebr)
plot(showLevels ? R1 : na, "R1", color.new(color.teal, 40), 1, plot.style_linebr)
plot(showLevels ? R2 : na, "R2", color.new(color.teal, 60), 1, plot.style_linebr)
plot(showLevels ? S1 : na, "S1", color.new(color.maroon, 40), 1, plot.style_linebr)
plot(showLevels ? S2 : na, "S2", color.new(color.maroon, 60), 1, plot.style_linebr)

if showTable and barstate.islast
    var table t = table.new(position.top_right, 2, 7, border_width = 1)
    table.cell(t, 0, 0, "ORB+VWAP+FIB", bgcolor = color.new(color.blue, 80), text_color = color.white)
    table.cell(t, 1, 0, str.tostring(score) + "/" + str.tostring(maxScore),
         bgcolor = color.new(color.blue, 80), text_color = color.white)
    table.cell(t, 0, 1, "OR High")
    table.cell(t, 1, 1, str.tostring(orH, format.mintick))
    table.cell(t, 0, 2, "OR Low")
    table.cell(t, 1, 2, str.tostring(orL, format.mintick))
    table.cell(t, 0, 3, "VWAP")
    table.cell(t, 1, 3, str.tostring(vwapVal, format.mintick))
    table.cell(t, 0, 4, "Pivot P")
    table.cell(t, 1, 4, str.tostring(P, format.mintick))
    table.cell(t, 0, 5, "R1 / S1")
    table.cell(t, 1, 5, str.tostring(R1, format.mintick) + " / " + str.tostring(S1, format.mintick))
    table.cell(t, 0, 6, "Trades today")
    table.cell(t, 1, 6, str.tostring(tradesDay))
